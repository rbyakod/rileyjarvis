{
  "name": "rileyjarvis",
  "version": "1.0.0",
  "description": "A local Electron desktop AI companion powered by OpenAI Realtime.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/copy-voice-assets.mjs && concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "start": "electron .",
    "build": "node scripts/copy-voice-assets.mjs && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "voice:assets": "node scripts/copy-voice-assets.mjs",
    "postinstall": "node scripts/copy-voice-assets.mjs"
  },
  "keywords": [
    "electron",
    "openai",
    "realtime",
    "voice",
    "desktop-assistant",
    "ai-companion"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@ricky0123/vad-web": "^0.0.30",
    "dotenv": "^17.4.2",
    "kokoro-js": "^1.2.1",
    "lucide-react": "^1.22.0",
    "mermaid": "^11.16.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "electron": "^42.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "wait-on": "^9.0.10"
  }
}
